import { test, expect } from "@playwright/test";
test("landing menampilkan judul & tombol masuk", async ({ page }) => {
  await page.goto("/");
  await expect(page.getByRole("heading", { name: /Pengajuan Account Payable/i })).toBeVisible();
  await expect(page.getByRole("link", { name: /Masuk/i }).first()).toBeVisible();
});
test("rute terlindungi redirect ke login", async ({ page }) => {
  await page.goto("/pengajuan");
  await expect(page).toHaveURL(/\/login/);
});
